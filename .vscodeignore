src/**
native/*.m
.gitignore
.vscodeignore
**/tsconfig.json
**/.eslintrc.json
**/*.map
**/*.ts
node_modules/**
# mobilecli は実行時に必要。darwin 版だけ同梱する（他プラットフォーム分で +38MB になるため）。
# 同梱に失敗しても MobileCliServer が npx 実行にフォールバックする。
!node_modules/@mobilenext/mobilecli/package.json
!node_modules/@mobilenext/mobilecli/index.js
!node_modules/@mobilenext/mobilecli/bin/mobilecli-darwin-*
# GitHub README はリポジトリ内の相対パスで参照。VSIX サイズ削減のため demo.gif だけ同梱しない。
media/demo.gif

*.md
!README.md
!README_JP.md
!CHANGELOG.md
!LICENSE.md
# 同梱する mobilecli は AGPL-3.0。全文と入手先の同梱が再配布の条件なので外さない。
!THIRD-PARTY-NOTICES.md
