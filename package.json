{
  "name": "secondary-simulator",
  "displayName": "Secondary Simulator",
  "description": "%extension.description%",
  "version": "0.5.0",
  "publisher": "yuuki-sakai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/den0206/secondary-simulator"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "galleryBanner": {
    "color": "#38bdf8",
    "theme": "light"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "ios",
    "android",
    "simulator",
    "emulator",
    "preview",
    "mobile"
  ],
  "activationEvents": [
    "onDebug"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simulator-container",
          "title": "%viewsContainer.title%",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "simulator-container": [
        {
          "type": "webview",
          "id": "simulatorView",
          "name": "%view.devicePreview.name%"
        }
      ]
    },
    "commands": [
      {
        "command": "simulator.selectDevice",
        "title": "%command.selectDevice.title%",
        "category": "%extension.category%"
      },
      {
        "command": "simulator.screenshot",
        "title": "%command.screenshot.title%",
        "category": "%extension.category%",
        "icon": "$(device-camera)"
      },
      {
        "command": "simulator.openUrl",
        "title": "%command.openUrl.title%",
        "category": "%extension.category%",
        "icon": "$(link)"
      },
      {
        "command": "simulator.home",
        "title": "%command.home.title%",
        "category": "%extension.category%"
      },
      {
        "command": "simulator.back",
        "title": "%command.back.title%",
        "category": "%extension.category%"
      },
      {
        "command": "simulator.record",
        "title": "%command.record.title%",
        "category": "%extension.category%",
        "icon": "$(record)"
      },
      {
        "command": "simulator.refresh",
        "title": "%command.refresh.title%",
        "category": "%extension.category%",
        "icon": "$(refresh)"
      },
      {
        "command": "simulator.showLogs",
        "title": "%command.showLogs.title%",
        "category": "%extension.category%",
        "icon": "$(output)"
      },
      {
        "command": "simulator.clearLogs",
        "title": "%command.clearLogs.title%",
        "category": "%extension.category%",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "simulator.refresh",
          "when": "view == simulatorView",
          "group": "navigation@2"
        },
        {
          "command": "simulator.showLogs",
          "when": "view == simulatorView",
          "group": "navigation@3"
        },
        {
          "command": "simulator.clearLogs",
          "when": "view == simulatorView",
          "group": "navigation@4"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "secondarySimulator.setup",
        "title": "%walkthrough.setup.title%",
        "description": "%walkthrough.setup.description%",
        "steps": [
          {
            "id": "moveToSecondarySideBar",
            "title": "%walkthrough.setup.move.title%",
            "description": "%walkthrough.setup.move.description%",
            "media": {
              "svg": "media/walkthrough/move.svg",
              "altText": "%walkthrough.setup.move.altText%"
            },
            "completionEvents": [
              "onStepSelected"
            ]
          },
          {
            "id": "connectDevice",
            "title": "%walkthrough.setup.connect.title%",
            "description": "%walkthrough.setup.connect.description%",
            "media": {
              "image": "media/icon.png",
              "altText": "%walkthrough.setup.connect.altText%"
            },
            "completionEvents": [
              "onCommand:simulator.selectDevice"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "secondarySimulator.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoConnect.description%"
        },
        "secondarySimulator.autoShow": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoShow.description%"
        },
        "secondarySimulator.autoShowDebugTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "dart",
            "reactnative",
            "reactnativedirect",
            "android",
            "sweetpad-lldb"
          ],
          "description": "%configuration.autoShowDebugTypes.description%"
        },
        "secondarySimulator.directStream": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.directStream.description%"
        },
        "secondarySimulator.streamScale": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 1,
          "description": "%configuration.streamScale.description%"
        },
        "secondarySimulator.streamQuality": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "%configuration.streamQuality.description%"
        },
        "secondarySimulator.keyInput": {
          "type": "string",
          "enum": [
            "hid",
            "wda"
          ],
          "enumDescriptions": [
            "%configuration.keyInput.enum.hid%",
            "%configuration.keyInput.enum.wda%"
          ],
          "default": "hid",
          "description": "%configuration.keyInput.description%"
        },
        "secondarySimulator.captureSource": {
          "type": "string",
          "enum": [
            "auto",
            "wda"
          ],
          "enumDescriptions": [
            "%configuration.captureSource.enum.auto%",
            "%configuration.captureSource.enum.wda%"
          ],
          "default": "auto",
          "description": "%configuration.captureSource.description%"
        },
        "secondarySimulator.captureFps": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 60,
          "description": "%configuration.captureFps.description%"
        },
        "secondarySimulator.captureMaxWidth": {
          "type": "number",
          "default": 640,
          "minimum": 160,
          "maximum": 2048,
          "description": "%configuration.captureMaxWidth.description%"
        },
        "secondarySimulator.captureMode": {
          "type": "string",
          "enum": [
            "auto",
            "poll"
          ],
          "enumDescriptions": [
            "%configuration.captureMode.enum.auto%",
            "%configuration.captureMode.enum.poll%"
          ],
          "default": "auto",
          "description": "%configuration.captureMode.description%"
        },
        "secondarySimulator.recordingSource": {
          "type": "string",
          "enum": [
            "device",
            "view"
          ],
          "enumDescriptions": [
            "%configuration.recordingSource.enum.device%",
            "%configuration.recordingSource.enum.view%"
          ],
          "default": "view",
          "description": "%configuration.recordingSource.description%"
        },
        "secondarySimulator.showTouchTrail": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showTouchTrail.description%"
        },
        "secondarySimulator.showDeviceFrame": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.showDeviceFrame.description%"
        },
        "secondarySimulator.showResourceStats": {
          "type": "boolean",
          "default": false,
          "description": "%configuration.showResourceStats.description%"
        },
        "secondarySimulator.saveLocation": {
          "type": "string",
          "enum": [
            "desktop",
            "workspace",
            "home",
            "custom"
          ],
          "enumDescriptions": [
            "%configuration.saveLocation.enum.desktop%",
            "%configuration.saveLocation.enum.workspace%",
            "%configuration.saveLocation.enum.home%",
            "%configuration.saveLocation.enum.custom%"
          ],
          "default": "desktop",
          "description": "%configuration.saveLocation.description%"
        },
        "secondarySimulator.saveDirectory": {
          "type": "string",
          "default": "",
          "description": "%configuration.saveDirectory.description%"
        },
        "secondarySimulator.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "enumDescriptions": [
            "%configuration.logLevel.enum.off%",
            "%configuration.logLevel.enum.error%",
            "%configuration.logLevel.enum.warn%",
            "%configuration.logLevel.enum.info%",
            "%configuration.logLevel.enum.debug%"
          ],
          "default": "info",
          "description": "%configuration.logLevel.description%"
        }
      }
    },
    "keybindings": [
      {
        "command": "simulator.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "focusedView == simulatorView"
      },
      {
        "command": "simulator.home",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "focusedView == simulatorView"
      },
      {
        "command": "simulator.back",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "focusedView == simulatorView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "build:native": "sh scripts/build-native.sh",
    "build": "npm run compile && npm run build:native",
    "package": "node -e \"require('node:fs').mkdirSync('vsix',{recursive:true})\" && vsce package --out vsix/secondary-simulator.vsix",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out native/simhid-server"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "mobilecli": "1.0.5"
  }
}
