{
  "name": "secondary-simulator",
  "displayName": "Secondary Simulator",
  "description": "Display iOS/Android simulators in the sidebar with real-time screen capture",
  "version": "0.1.0",
  "publisher": "yuuki-sakai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/den0206/secondary-simulator"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "galleryBanner": {
    "color": "#38bdf8",
    "theme": "light"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "ios",
    "android",
    "simulator",
    "emulator",
    "preview",
    "mobile"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simulator-container",
          "title": "Simulator",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "simulator-container": [
        {
          "type": "webview",
          "id": "simulatorView",
          "name": "Device Preview"
        }
      ]
    },
    "commands": [
      {
        "command": "simulator.selectDevice",
        "title": "Simulator: Select Device"
      },
      {
        "command": "simulator.home",
        "title": "Simulator: Press Home"
      },
      {
        "command": "simulator.back",
        "title": "Simulator: Press Back"
      },
      {
        "command": "simulator.refresh",
        "title": "Simulator: Refresh Device List"
      }
    ],
    "configuration": {
      "title": "Secondary Simulator",
      "properties": {
        "secondarySimulator.directStream": {
          "type": "boolean",
          "default": false,
          "description": "表示を webview 直結 MJPEG（<img>）にする。フレームが拡張ホストを経由せず、Chromium がネイティブ復号する。実験的。"
        },
        "secondarySimulator.streamScale": {
          "type": "number",
          "default": 1.0,
          "minimum": 0.1,
          "maximum": 1.0,
          "description": "iOS: MJPEG の縮小率（1.0=原寸）。小さくすると帯域が下がる（WDA の mjpegScalingFactor を設定）。"
        },
        "secondarySimulator.streamQuality": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "iOS: MJPEG の JPEG 品質（1-100）。streamScale と併用して帯域を調整する。"
        }
      }
    },
    "keybindings": [
      {
        "command": "simulator.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "view == simulatorView"
      },
      {
        "command": "simulator.home",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "view == simulatorView"
      },
      {
        "command": "simulator.back",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "view == simulatorView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "build:native": "sh scripts/build-native.sh",
    "build": "npm run compile && npm run build:native",
    "package": "node -e \"require('node:fs').mkdirSync('vsix',{recursive:true})\" && vsce package --out vsix/secondary-simulator.vsix",
    "test": "npm run compile && node test/webview-pointer.test.js && node test/sidecar-protocol.test.js",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out native/simhid-server"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mobilenext/mobilecli": "^0.1.64"
  }
}
