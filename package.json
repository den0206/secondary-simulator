{
  "name": "secondary-simulator",
  "displayName": "Secondary Simulator",
  "description": "Display iOS/Android simulators in the sidebar with real-time screen capture",
  "version": "0.1.1",
  "publisher": "yuuki-sakai",
  "icon": "media/icon.png",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/den0206/secondary-simulator"
  },
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "galleryBanner": {
    "color": "#38bdf8",
    "theme": "light"
  },
  "categories": [
    "Debuggers",
    "Other"
  ],
  "keywords": [
    "ios",
    "android",
    "simulator",
    "emulator",
    "preview",
    "mobile"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "simulator-container",
          "title": "Secondary Simulator",
          "icon": "$(device-mobile)"
        }
      ]
    },
    "views": {
      "simulator-container": [
        {
          "type": "webview",
          "id": "simulatorView",
          "name": "Device Preview"
        }
      ]
    },
    "commands": [
      {
        "command": "simulator.selectDevice",
        "title": "Select Device",
        "category": "Secondary Simulator"
      },
      {
        "command": "simulator.screenshot",
        "title": "Save Screenshot",
        "category": "Secondary Simulator",
        "icon": "$(device-camera)"
      },
      {
        "command": "simulator.openUrl",
        "title": "Open URL on Device",
        "category": "Secondary Simulator",
        "icon": "$(link)"
      },
      {
        "command": "simulator.home",
        "title": "Press Home",
        "category": "Secondary Simulator"
      },
      {
        "command": "simulator.back",
        "title": "Press Back",
        "category": "Secondary Simulator"
      },
      {
        "command": "simulator.refresh",
        "title": "Refresh Device List",
        "category": "Secondary Simulator",
        "icon": "$(refresh)"
      },
      {
        "command": "simulator.showLogs",
        "title": "Show Logs",
        "category": "Secondary Simulator",
        "icon": "$(output)"
      },
      {
        "command": "simulator.clearLogs",
        "title": "Clear Logs",
        "category": "Secondary Simulator",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "simulator.refresh",
          "when": "view == simulatorView",
          "group": "navigation@2"
        },
        {
          "command": "simulator.showLogs",
          "when": "view == simulatorView",
          "group": "navigation@3"
        },
        {
          "command": "simulator.clearLogs",
          "when": "view == simulatorView",
          "group": "navigation@4"
        }
      ]
    },
    "configuration": {
      "title": "Secondary Simulator",
      "properties": {
        "secondarySimulator.autoConnect": {
          "type": "boolean",
          "default": true,
          "description": "起動中のデバイスへ自動で接続する。未接続のあいだは5秒ごとに探し、新しく起動したシミュレータにも繋ぐ。サイドバーの Auto ボタンと連動し、Disconnect を押すと OFF になる。"
        },
        "secondarySimulator.directStream": {
          "type": "boolean",
          "default": false,
          "description": "表示を webview 直結 MJPEG（<img>）にする。フレームが拡張ホストを経由せず、Chromium がネイティブ復号する。実験的。"
        },
        "secondarySimulator.streamScale": {
          "type": "number",
          "default": 1,
          "minimum": 0.1,
          "maximum": 1,
          "description": "iOS: MJPEG の縮小率（1.0=原寸）。小さくすると帯域が下がる（WDA の mjpegScalingFactor を設定）。"
        },
        "secondarySimulator.streamQuality": {
          "type": "number",
          "default": 80,
          "minimum": 1,
          "maximum": 100,
          "description": "iOS: MJPEG の JPEG 品質（1-100）。streamScale と併用して帯域を調整する。"
        },
        "secondarySimulator.keyInput": {
          "type": "string",
          "enum": [
            "hid",
            "wda"
          ],
          "enumDescriptions": [
            "HID 直接注入（速い）。シミュレータはハードウェアキーボード扱いになり、ソフトウェアキーボードが表示されない。",
            "WDA 経由（1文字あたり約 370ms）。ソフトウェアキーボードが表示されたままになり、端末側の入力ソース（英字/かな）にも左右されない。"
          ],
          "default": "hid",
          "description": "iOS: キーボード入力の経路。タッチは常に HID のまま。サイドバーにソフトウェアキーボードを映したいときは wda にする。"
        },
        "secondarySimulator.captureSource": {
          "type": "string",
          "enum": [
            "auto",
            "wda"
          ],
          "enumDescriptions": [
            "iOS Simulator で HID サイドカーが使えるなら端末のフレームバッファを直接取り込む。ソフトウェアキーボードやステータスバーも写る。",
            "従来どおり mobilecli/WDA の MJPEG を使う。WDA のスクリーンショットはアプリのウィンドウしか描かないため、ソフトウェアキーボードは写らない。"
          ],
          "default": "auto",
          "description": "iOS: 画面の取り込み元。auto は HID サイドカーがあればフレームバッファ直取り、無ければ WDA へ降格する。"
        },
        "secondarySimulator.captureFps": {
          "type": "number",
          "default": 30,
          "minimum": 1,
          "maximum": 60,
          "description": "iOS: サイドカー取り込みの上限 fps。画面が変わらないフレームは送られない。"
        },
        "secondarySimulator.captureMaxWidth": {
          "type": "number",
          "default": 640,
          "minimum": 160,
          "maximum": 2048,
          "description": "iOS: サイドカー取り込みで送る JPEG の最大幅（px）。大きくすると鮮明になり帯域も増える。"
        },
        "secondarySimulator.logLevel": {
          "type": "string",
          "enum": [
            "off",
            "error",
            "warn",
            "info",
            "debug"
          ],
          "enumDescriptions": [
            "何も出力しない。",
            "エラーのみ。",
            "エラーと警告。",
            "通常の動作ログまで（既定）。",
            "受信メッセージなども含む詳細ログ。調査時だけ使う。"
          ],
          "default": "info",
          "description": "出力チャンネル \"Secondary Simulator\" へ書くログの詳しさ。VS Code は出力チャンネルの全文をメモリに保持し古い行を捨てられないので、常用は info 以下にする。"
        }
      }
    },
    "keybindings": [
      {
        "command": "simulator.refresh",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "focusedView == simulatorView"
      },
      {
        "command": "simulator.home",
        "key": "ctrl+shift+h",
        "mac": "cmd+shift+h",
        "when": "focusedView == simulatorView"
      },
      {
        "command": "simulator.back",
        "key": "ctrl+shift+b",
        "mac": "cmd+shift+b",
        "when": "focusedView == simulatorView"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "compile": "tsc -p ./",
    "typecheck": "tsc -p ./ --noEmit",
    "build:native": "sh scripts/build-native.sh",
    "build": "npm run compile && npm run build:native",
    "package": "node -e \"require('node:fs').mkdirSync('vsix',{recursive:true})\" && vsce package --out vsix/secondary-simulator.vsix",
    "test": "npm run compile && node --test test/*.test.js",
    "watch": "tsc -watch -p ./",
    "clean": "rm -rf out native/simhid-server"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.9.2",
    "@types/node": "^26.2.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@mobilenext/mobilecli": "^0.1.64"
  }
}
